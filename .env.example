# Copy to .env (gitignored) and fill in. Variables already set in the
# environment take precedence over this file.

# Required: the GCP project and zone for cloud VMs.
GCP_PROJECT=
GCP_ZONE=

# bootc dev VM (bootc-vm/). Defaults shown.
# BOOTC_VM_NAME=bootc-dev
# BOOTC_VM_MACHINE_TYPE=n2-standard-16
# BOOTC_VM_DISK_GB=200
# BOOTC_VM_SPOT=false
# BOOTC_VM_NETWORK=default
# BOOTC_VM_IDLE_MINUTES=60
# BOOTC_ACTIONS_REF=main
